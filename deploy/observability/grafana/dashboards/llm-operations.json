      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toStartOfMinute(start_time) AS time, sum(usage_details['input']) AS input_tokens, sum(usage_details['output']) AS output_tokens FROM default.observations WHERE type = 'GENERATION' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Token Usage Over Time (Input vs Output)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "fieldConfig": {
        "defaults": {
