      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name, count() AS calls FROM default.observations WHERE type = 'GENERATION' GROUP BY name ORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "title": "Calls by Table (Adjudication Target)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "description": "Every real LLM call this pipeline has made, most recent first \u2014 the prompt/response themselves live in Langfuse (linked from Tracing), this is the operational summary: model, tokens, cost, latency.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time: YYYY-MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "latency_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 13
      },
      "id": 6,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT start_time AS time, name, coalesce(provided_model_name, 'n/a') AS model, usage_details['input'] AS input_tokens, usage_details['output'] AS output_tokens, coalesce(total_cost, 0) AS cost_usd, dateDiff('millisecond', start_time, end_time) AS latency_ms FROM default.observations WHERE type = 'GENERATION' ORDER BY start_time DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Generations",
      "type": "table"
    }
