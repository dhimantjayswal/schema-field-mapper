ANTHROPIC_API_KEY=your-key-here

# Optional — set these to trace every LLM call (prompt, response, tokens,
# cost) to a Langfuse instance. run_pipeline.py auto-enables tracing when
# LANGFUSE_PUBLIC_KEY is present. Values below match the local dev stack
# in deploy/observability/ (`docker compose up`, then create a project at
# http://localhost:3001 and copy its keys here).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001
